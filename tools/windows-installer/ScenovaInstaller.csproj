<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishReadyToRun>false</PublishReadyToRun>
    <PublishTrimmed>false</PublishTrimmed>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <AssemblyName>SCENOVA-Setup</AssemblyName>
    <AssemblyTitle>SCENOVA Windows Setup</AssemblyTitle>
    <Product>SCENOVA MT5 BOT EA</Product>
    <Company>SCENOVA</Company>
    <Authors>SCENOVA</Authors>
    <Description>SCENOVA MT5 BOT EA Windows Installer and Device Agent</Description>
    <Copyright>Copyright © SCENOVA</Copyright>
    <Version>2.0.7</Version>
    <FileVersion>2.0.7.0</FileVersion>
    <AssemblyVersion>2.0.7.0</AssemblyVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>
</Project>
