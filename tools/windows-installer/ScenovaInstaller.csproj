<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishReadyToRun>false</PublishReadyToRun>
    <PublishTrimmed>false</PublishTrimmed>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <AssemblyName>SCENOVA-Setup</AssemblyName>
    <AssemblyTitle>SCENOVA Smart Installer</AssemblyTitle>
    <Product>SCENOVA Smart Installer</Product>
    <Company>SCENOVA</Company>
    <Authors>SCENOVA</Authors>
    <Description>SCENOVA Smart Installer, Repair, Verification and Device Agent</Description>
    <Copyright>Copyright © SCENOVA</Copyright>
    <Version>1.0.14</Version>
    <FileVersion>1.0.14.0</FileVersion>
    <AssemblyVersion>1.0.14.0</AssemblyVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
    <EmbeddedResource Include="Assets/scenova-installer-mark-v1.png" LogicalName="ScenovaInstaller.BrandMark" />
  </ItemGroup>
</Project>
