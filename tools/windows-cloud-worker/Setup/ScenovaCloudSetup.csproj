<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <AssemblyName>SCENOVA-Cloud-Setup</AssemblyName>
    <RootNamespace>Scenova.CloudSetup</RootNamespace>
    <Version>0.6.24</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
    <EmbeddedResource Include="../../../mt5/release/FastBasketBot.ex5"
                      LogicalName="SCENOVA.Payload.FastBasketBot.ex5" />
    <EmbeddedResource Include="../../../mt5/release/ScenovaSymbolProbe.ex5"
                      LogicalName="SCENOVA.Payload.ScenovaSymbolProbe.ex5" />
    <EmbeddedResource Include="$(WorkerPayloadPath)"
                      LogicalName="SCENOVA.Payload.SCENOVA-CloudWorker.exe"
                      Condition="'$(WorkerPayloadPath)' != '' and Exists('$(WorkerPayloadPath)')" />
  </ItemGroup>
</Project>
