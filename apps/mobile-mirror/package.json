    "react-native": "0.81.4",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-webrtc": "124.0.8"
  },
  "devDependencies": {
    "@types/react": "~19.1.10",
    "typescript": "~5.9.2"
  }
}
