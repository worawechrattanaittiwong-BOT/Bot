{
  "name": "@bot/owner-mobile",
  "private": true,
  "version": "0.1.0",
  "main": "expo/AppEntry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit",
    "preview:ui": "node scripts/preview-ui.mjs",
    "test:ui": "node --test tests/finance.test.mjs",
    "build:android:apk": "expo prebuild --platform android --clean --no-install && cd android && ./gradlew assembleRelease"
  },
  "dependencies": {
    "expo": "~54.0.0",
    "expo-crypto": "~15.0.7",
    "expo-file-system": "~19.0.24",
    "expo-intent-launcher": "~13.0.8",
    "expo-secure-store": "~15.0.7",
    "expo-status-bar": "~3.0.8",
    "react": "19.1.0",
    "react-native": "0.81.4",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-svg": "15.12.1"
  },
  "devDependencies": {
    "@types/react": "~19.1.10",
    "@types/react-dom": "19.1.9",
    "esbuild": "^0.25.0",
    "react-dom": "19.1.0",
    "react-native-web": "~0.21.0",
    "typescript": "~5.9.2"
  }
}
